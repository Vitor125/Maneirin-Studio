{
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.code-workspace"
    ],
    "rewrites": [
      {
        "source": "/barbeiro/**",
        "destination": "/barbeiro/index.html"
      },
      {
        "source": "/cliente/**",
        "destination": "/cliente/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: http:; connect-src 'self' https://*.googleapis.com; frame-src https://site-maneirin-studio.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/cliente/",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/cliente/",
        "type": 301
      },
      {
        "source": "/dashboard.html",
        "destination": "/barbeiro/",
        "type": 301
      },
      {
        "source": "/agenda",
        "destination": "/cliente/agenda/",
        "type": 301
      },
      {
        "source": "/agenda/",
        "destination": "/cliente/agenda/",
        "type": 301
      },
      {
        "source": "/agenda/index.html",
        "destination": "/cliente/agenda/",
        "type": 301
      },
      {
        "source": "/produtos",
        "destination": "/cliente/produtos/",
        "type": 301
      },
      {
        "source": "/produtos/",
        "destination": "/cliente/produtos/",
        "type": 301
      },
      {
        "source": "/produtos/index.html",
        "destination": "/cliente/produtos/",
        "type": 301
      }
    ]
  }
}
